# Security headers on every response. The CSP allows only same-origin
# resources plus inline styles (the game sets element styles directly) —
# there are no external scripts, fonts, or frames anywhere in the app.
/*
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML shell is served at these paths (never as /index.html — the SPA
# fallback and the /guide/ index files answer for it). It must revalidate on
# every load so a deploy's new hashed asset names are seen at once.
/
  Cache-Control: no-cache

/companion
  Cache-Control: no-cache

/guide/*
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
