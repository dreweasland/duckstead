{
  "name": "duck-simulator",
  "description": "Duck Homestead — a browser game where every duck is drawn from its genes",
  "private": true,
  "license": "UNLICENSED",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p worker --noEmit",
    "lint": "eslint .",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
