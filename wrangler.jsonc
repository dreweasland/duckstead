// Cloudflare Workers config. `npx wrangler deploy` bundles the sync Worker
// (worker/index.ts + the DuckSyncDO Durable Object) and uploads the Vite
// build in ./dist as static assets; `public/_headers` is honoured.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duckstead",
  "compatibility_date": "2025-08-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Single-page app: unknown paths (e.g. /companion) fall back to index.html.
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [{ "name": "SYNC", "class_name": "DuckSyncDO" }]
  },
  // Per-client throttle on the unauthenticated pairing routes (code
  // guessing, save minting). Legitimate use is a handful of calls a day.
  "ratelimits": [{ "name": "PAIR_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DuckSyncDO"] }]
}
